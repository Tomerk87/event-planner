# Settings of the production stack. On the server this file is
# /opt/event-planner/.env, readable by its owner only (chmod 600).
# Never commit the real file. See docs/DEPLOYMENT.md.

# The site's domain, without https:// (for example events.example.com).
DOMAIN=example.com
# Where Let's Encrypt sends certificate expiry warnings.
LETSENCRYPT_EMAIL=you@example.com

# Database password. Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=

# The version running, set by scripts/deploy.sh. Do not edit by hand.
APP_VERSION=

# Email (D88). off: nothing is sent. smtp: Amazon SES (docs/DEPLOYMENT.md, step 12).
EMAIL_MODE=off
SMTP_HOST=email-smtp.eu-central-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Event Planner <noreply@example.com>

# S3 bucket for the nightly backups (scripts/backup.sh). Empty: kept on the
# server only.
BACKUP_BUCKET=
