# Copy to .env for local development. Never commit real secrets.

# PostgreSQL started by docker-compose.dev.yml (development credentials only).
DATABASE_URL=postgresql://event_planner:event_planner_dev@localhost:5432/event_planner
# Used by the integration tests; they reset this database.
TEST_DATABASE_URL=postgresql://event_planner:event_planner_dev@localhost:5432/event_planner_test

# Port the API listens on.
PORT=3000
# The frontend's origin, allowed to call the API with its session cookie.
CORS_ORIGIN=http://localhost:5173
# development | production | test. Production marks the session cookie Secure.
NODE_ENV=development
# Where uploaded images are kept by the local storage.
UPLOAD_DIR=./uploads
# The application's own address, used in the RSVP link of WhatsApp messages.
# Defaults to CORS_ORIGIN.
# PUBLIC_APP_URL=https://events.example.com
# Sign-in and sign-up attempts allowed per minute from one address.
AUTH_ATTEMPTS_PER_MINUTE=10
# Public RSVP submissions allowed per window, from one IP address and for one
# phone number of an event (owner decision D2).
RSVP_LIMIT_PER_IP=10
RSVP_LIMIT_PER_PHONE=3
RSVP_LIMIT_WINDOW_MINUTES=10
# Proxies in front of the API whose X-Forwarded-For is trusted. 0 locally;
# 1 behind Nginx, or every guest would appear to share the proxy's address.
TRUST_PROXY_HOPS=0

# Email (owner decision D88). Off by default: nothing is sent, new accounts
# count as verified and invitations take effect at sign-up. With smtp, the
# server sends verification, password-reset and invitation emails.
EMAIL_MODE=off
# With EMAIL_MODE=smtp. Locally, Mailpit from docker-compose.dev.yml catches
# every email (see http://localhost:8025). In production, Amazon SES's SMTP
# endpoint, with SMTP credentials kept out of the repository.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=Event Planner <noreply@localhost>
# How long a verification link and a password-reset link work.
# EMAIL_VERIFY_HOURS=24
# PASSWORD_RESET_MINUTES=60
# Emails of each kind allowed per address per hour.
# EMAIL_LIMIT_PER_HOUR=3
