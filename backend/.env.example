# Copy to .env for local development. Never commit real secrets.

# PostgreSQL started by docker-compose.dev.yml (development credentials only).
DATABASE_URL=postgresql://event_planner:event_planner_dev@localhost:5432/event_planner
# Used by the integration tests; they reset this database.
TEST_DATABASE_URL=postgresql://event_planner:event_planner_dev@localhost:5432/event_planner_test

# Port the API listens on.
PORT=3000
# The frontend's origin, allowed to call the API with its session cookie.
CORS_ORIGIN=http://localhost:5173
# development | production | test. Production marks the session cookie Secure.
NODE_ENV=development
# Where uploaded images are kept by the local storage.
UPLOAD_DIR=./uploads
