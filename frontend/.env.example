# Copy to .env.local to override. Do not put secrets here: every VITE_ value is embedded in the public build.

# Whether this deployment offers the public demo (Try Demo). "true" (default) or "false".
# Signed-in accounts always use the backend at /api (proxied to http://localhost:3000 by `npm run dev`).
VITE_DEMO_ENABLED=true

# Whether this deployment has real accounts (Sign In, Sign Up, the API). "true" (default) or "false".
# "false" makes a demo-only site that needs no server (netlify.toml, docs/DEPLOYMENT.md). Not both false.
VITE_ACCOUNTS_ENABLED=true
